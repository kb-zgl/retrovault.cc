# RetroVault Nuxt 本地开发环境变量
# 复制此文件为 .env 后填入真实值

# D1 HTTP API（本地 dev 连接远程 D1 用）
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_TOKEN=
CLOUDFLARE_D1_DATABASE_ID=

# API 远程接口地址（SSR回退用）
NUXT_API_BASE=https://retrovault.solomaker282.workers.dev

# CDN 域名（用于 cover / ROM 等的 R2 公开 URL）
NUXT_R2_PUBLIC_URL=https://cdn.retrovault.online/
